<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sub_header_container"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/sort_button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/pill_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sort_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="Date modified"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/sort_arrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            app:srcCompat="@drawable/ic_keyboard_arrow_up_24dp"
            app:tint="?attr/colorOnSurface"/>

    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_count_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textAppearance="?textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="533 Songs"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/header_layout_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:visibility="gone"
        app:icon="@drawable/ic_grid_view_24dp"
        app:iconSize="20dp"
        app:iconTint="?attr/colorOnSurface"
        tools:visibility="visible"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/header_action_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:visibility="gone"
        app:icon="@drawable/ic_add_24dp"
        app:iconSize="20dp"
        app:iconTint="?attr/colorOnSurface"
        tools:visibility="visible"/>

</LinearLayout>
